#requires -Version 5.1
<#
Generated by Printer Deployment Tool. Copy this standalone file to the GPO's
computer Startup / PowerShell Scripts folder. No script parameters are required.
It registers the SYSTEM task; that task loads the deployment bundle from the share.
If your policy requires signing, sign this generated file after exporting it.
Pilot: .\Install-PrinterDeploymentTask.ps1 -WhatIf
#>
[CmdletBinding()]
param([switch]$WhatIf)
$ErrorActionPreference = 'Stop'

function Assert-PDTaskHost {
    if ($env:OS -ne 'Windows_NT' -or -not [Environment]::Is64BitProcess) { throw 'Run this startup script in native 64-bit Windows PowerShell.' }
    $principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Task registration requires SYSTEM or an elevated administrator.' }
}

function Invoke-PDTaskRegistration {
    [CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'Medium')]
    param()
    $root = __PDT_ROOT_LITERAL__
    $deploymentId = '__PDT_DEPLOYMENT_ID__'
    if ($root -notmatch '^\\\\[^\\]+\\[^\\]+' -or $root -match '["\r\n]') {
        throw 'Choose a UNC deployment folder in the GUI and export again before using this file in GPO.'
    }
    Assert-PDTaskHost
    Import-Module ScheduledTasks -ErrorAction Stop
    $taskName = 'PrinterDeploymentTool-' + $deploymentId
    $description = 'Printer Deployment Tool; DeploymentId=' + $deploymentId
    $existing = Get-ScheduledTask -TaskName $taskName -TaskPath '\' -ErrorAction SilentlyContinue
    if ($existing -and $existing.Description -ne $description) { throw "Task '$taskName' already exists outside this tool's management." }
    if (-not $PSCmdlet.ShouldProcess($taskName, "Register or update SYSTEM printer deployment from $root")) { return }
    # Build UNC strings without a provider lookup; the share may be offline at boot.
    $scriptPath = $root.TrimEnd('\') + '\PrinterDeployment.ps1'
    $configPath = $root.TrimEnd('\') + '\printers.json'
    $arguments = '-NoProfile -NonInteractive -File "{0}" -Mode Deploy -ConfigPath "{1}"' -f $scriptPath, $configPath
    $action = New-ScheduledTaskAction -Execute (Join-Path $env:windir 'System32\WindowsPowerShell\v1.0\powershell.exe') -Argument $arguments
    $principal = New-ScheduledTaskPrincipal -UserId 'S-1-5-18' -LogonType ServiceAccount -RunLevel Highest
    $boot = New-ScheduledTaskTrigger -AtStartup
    $boot.Delay = 'PT1M'
    $daily = New-ScheduledTaskTrigger -Daily -At ([datetime]::Today.AddHours(12))
    # Registration happens after this boot's trigger event. Schedule a run this boot too.
    $firstRun = New-ScheduledTaskTrigger -Once -At ((Get-Date).AddMinutes(1))
    $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew `
        -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 5) `
        -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Hours 1)
    Register-ScheduledTask -TaskName $taskName -TaskPath '\' -Action $action -Principal $principal `
        -Trigger @($boot, $daily, $firstRun) -Settings $settings -Description $description -Force -ErrorAction Stop | Out-Null
    Write-Output "Registered $taskName. Deployment runs in about one minute, at future startups, and daily at noon."
}

# Dot-sourcing exposes registration for testing; ordinary GPO execution runs it.
if ($MyInvocation.InvocationName -ne '.') {
    try { Invoke-PDTaskRegistration -WhatIf:$WhatIf; exit 0 }
    catch { Write-Error -Message $_.Exception.Message -ErrorAction Continue; exit 1 }
}
