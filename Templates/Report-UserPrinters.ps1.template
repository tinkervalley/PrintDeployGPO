#requires -Version 5.1
<#
Generated by Printer Deployment Tool. Copy this standalone file to the GPO's
User Configuration / Logon / PowerShell Scripts folder. Leave parameters blank.
Runs as the signed-in user to report shared-printer connections invisible to SYSTEM.
The cleanup checkbox controls only legacy-name removals; reporting always runs.
Explicit GUI-selected removals for this computer/user also apply on each logon.
Sign this file after exporting if your organization's execution policy requires it.
#>
[CmdletBinding()]
param([switch]$WhatIf)
$ErrorActionPreference = 'Stop'
function Invoke-PDUserLogon {
    $root = __PDT_ROOT_LITERAL__
    if ($root -notmatch '^\\\\[^\\]+\\[^\\]+' -or $root -match '["\r\n]') {
        throw 'Choose a UNC deployment folder in the GUI and export again before using this file in GPO.'
    }
    $scriptPath = $root.TrimEnd('\') + '\PrinterDeployment.ps1'
    $configPath = $root.TrimEnd('\') + '\printers.json'
    $arguments = @('-NoProfile', '-NonInteractive', '-File', $scriptPath, '-Mode', 'CleanupUser', '-ConfigPath', $configPath)
    if ($WhatIf) { $arguments += '-WhatIf' }
    & (Join-Path $env:windir 'System32\WindowsPowerShell\v1.0\powershell.exe') @arguments
    if ($LASTEXITCODE -ne 0) { throw "User printer inventory/cleanup failed with exit code $LASTEXITCODE." }
}
if ($MyInvocation.InvocationName -ne '.') {
    try { Invoke-PDUserLogon; exit 0 }
    catch { Write-Error -Message $_.Exception.Message -ErrorAction Continue; exit 1 }
}
